# Database URLs
DATABASE_URL=postgresql://migrator:migrator_secret@localhost:5432/marketing_engine
APP_ROLE_URL=postgresql://app_user:app_secret@localhost:5432/marketing_engine
LEARNING_ROLE_URL=postgresql://learning_svc:learning_secret@localhost:5432/marketing_engine

# Operational Mode & Autonomy
DRY_RUN=true
LIVE_SENDS=false

# LLM Configuration
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=your-groq-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Cryptography & Security Keys
# PII_ENCRYPTION_KEY must be a 32-byte base64-encoded key
PII_ENCRYPTION_KEY=vS8zC8rVl71Dk6fQWk3Xz9J2gN7tVb6uY4eO1pP8lDs=
TENANT_HMAC_MASTER_KEY=kL9mB7xP2wQ4vC8nZ1tY6rJ3gH5eD0fA=
JWT_SECRET=super-secret-jwt-signing-key-for-auth-token-validation

# Third-Party Connector Secrets
